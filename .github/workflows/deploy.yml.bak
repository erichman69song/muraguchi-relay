name: Deploy to EC2

on:
  push:
    branches: [main]
    paths-ignore:
      - "*.md"

jobs:
  deploy:
    name: Deploy relay to EC2
    runs-on: ubuntu-latest

    steps:
      - name: Deploy to EC2 via SSH
        uses: appleboy/ssh-action@v1.0.3
        with:
          host: ${{ secrets.EC2_HOST }}
          username: ubuntu
          key: ${{ secrets.EC2_SSH_KEY }}
          port: 22
          timeout: 300s
          envs: OPENAI_API_KEY,GOOGLE_API_KEY
          script: |
            set -e
            cd /opt/muraguchi-relay

            git fetch origin
            git reset --hard origin/main
            echo "Code updated to $(git rev-parse --short HEAD)"

            # Update API keys in .env from GitHub Actions env vars
            if [ -n "$OPENAI_API_KEY" ]; then
              echo "Updating OpenAI API key..."
              sed -i "s|^OPENAI_API_KEY=.*|OPENAI_API_KEY=$OPENAI_API_KEY|" /opt/muraguchi-relay/.env
            fi
            if [ -n "$GOOGLE_API_KEY" ]; then
              echo "Updating Google API key..."
              sed -i "s|^GOOGLE_API_KEY=.*|GOOGLE_API_KEY=$GOOGLE_API_KEY|" /opt/muraguchi-relay/.env
            fi

            SVC="/etc/systemd/system/muraguchi-relay.service"
            if [ ! -f "$SVC" ]; then
              echo "Creating systemd service file..."
              printf '[Unit]\nDescription=Muraguchi Relay Service\nAfter=network.target\n\n[Service]\nType=simple\nUser=ubuntu\nWorkingDirectory=/opt/muraguchi-relay\nExecStart=/opt/muraguchi-relay/.venv/bin/python -m uvicorn relay_server:app --host 0.0.0.0 --port 8080\nRestart=always\nRestartSec=3\nStandardOutput=append:/opt/muraguchi-relay/relay.log\nStandardError=append:/opt/muraguchi-relay/relay.log\n\n[Install]\nWantedBy=multi-user.target\n' | sudo tee "$SVC" > /dev/null
              sudo chmod 644 "$SVC"
              sudo systemctl daemon-reload
              sudo systemctl enable muraguchi-relay
            fi

            echo "Restarting relay via systemd..."
            sudo systemctl restart muraguchi-relay

            sleep 4
            curl -sf http://localhost:8080/v1/relay/health && echo " Relay is healthy!" || {
              echo "Health check FAILED:"
              tail -15 /opt/muraguchi-relay/relay.log
              exit 1
            }
